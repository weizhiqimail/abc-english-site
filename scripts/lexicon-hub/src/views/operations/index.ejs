<%- include("../partials/header", { title: "批量操作", pageScript: "/assets/js/operations.js" }) %>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">批量操作</h1><div class="text-secondary">上传词汇图片到七牛或补全发音资源</div></div><span class="badge text-bg-dark">共 <%= total %> 个</span></div>
<div class="alert alert-info small">图片同步状态保存在 PostgreSQL 的 vocabulary_words 表中；数据库是发布状态的唯一事实来源。</div>
<form id="operation-filter" class="row g-2 mb-3" method="get">
  <div class="col-sm-3">
    <label class="form-label" for="operation-level">词汇等级</label>
    <select id="operation-level" name="level" class="form-select">
      <% ["A1", "A2", "B1", "B2", "C1", "C2"].forEach((level) => { %>
        <option value="<%= level %>" <%= filters.level === level ? "selected" : "" %>><%= level %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-sm-7">
    <label class="form-label" for="operation-category">词汇分类</label>
    <select id="operation-category" name="category" class="form-select">
      <% categories.forEach((category) => { %>
        <option value="<%= category.recordId %>" <%= filters.categoryRecordId === category.recordId ? "selected" : "" %>><%= category.title %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-sm-2 d-grid align-self-end"><button class="btn btn-primary">查看分类</button></div>
</form>
<div class="sticky-actions bg-light border rounded p-2 mb-3 d-flex flex-wrap gap-2 align-items-center shadow-sm">
  <button id="migrate-images" class="btn btn-success" disabled>上传所选图片到七牛</button>
  <button id="select-category" class="btn btn-outline-secondary">选择本分类全部词汇</button>
  <span id="selection-count" class="text-secondary small">已选择 0 个词汇</span>
</div>
<div id="message"></div>
<%- include("../partials/word-table", { selectable: true, showActions: true }) %>
<%- include("../partials/footer", { pageScript: "/assets/js/operations.js" }) %>
