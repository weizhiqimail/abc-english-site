<%- include("../partials/header", { title: "词汇等级", pageScript: "" }) %>
<div class="row g-4">
  <section class="col-12 col-lg-12">
    <h1 class="h3">词汇等级</h1>
    <p class="text-secondary">按 CEFR 等级查看分类数量和资源完成度。</p>
    <div class="row g-3">
      <% levels.forEach((item) => { %>
        <div class="col-12 col-md-6 col-xl-4">
          <a class="card h-100 text-decoration-none" href="/vocabulary/levels/<%= encodeURIComponent(item.level) %>">
            <div class="card-body">
              <div class="d-flex justify-content-between"><strong class="fs-4"><%= item.level %></strong><span><%= item.categories %> 个分类</span></div>
              <div class="mt-3">词汇 <%= item.total %></div>
              <div class="small text-secondary">图片 <%= item.withImage %> · 音标 <%= item.withPhonetic %> · 音频 <%= item.withAudio %></div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  </section>
</div>
<%- include("../partials/footer", { pageScript: "" }) %>
