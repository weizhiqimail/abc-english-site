<%- include("../partials/header", { title: "本地批量任务", pageScript: "/assets/js/tasks.js" }) %>
<div class="mb-4">
  <h1 class="h3 mb-1">本地批量任务</h1>
  <div class="text-secondary">按词汇等级创建完整任务，服务自动分批执行并实时推送进度</div>
</div>

<section class="card mb-4">
  <div class="card-header"><strong>创建任务</strong></div>
  <div class="card-body row g-3 align-items-end">
    <div class="col-md-2">
      <label class="form-label" for="task-type">任务类型</label>
      <select id="task-type" class="form-select">
        <% taskTypes.forEach((taskType) => { %><option value="<%= taskType.value %>"><%= taskType.label %></option><% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <label class="form-label" for="task-level">词汇等级</label>
      <select id="task-level" class="form-select">
        <% levels.forEach((item) => { %>
          <option value="<%= item.level %>" data-total="<%= item.total %>"><%= item.level %>（<%= item.total %> 个词汇）</option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <label class="form-label" for="task-batch-size">每批处理数量</label>
      <input id="task-batch-size" class="form-control" type="number" min="1" max="100" value="100" />
    </div>
    <div class="col-md-2">
      <div class="form-check mb-2">
        <input id="ignore-published" class="form-check-input" type="checkbox" checked />
        <label class="form-check-label" for="ignore-published">忽略已同步词汇</label>
      </div>
    </div>
    <div class="col-md-2 d-grid"><button id="start-task" class="btn btn-success">创建并执行</button></div>
    <div class="col-12"><div id="task-estimate" class="alert alert-secondary mb-0"></div></div>
  </div>
</section>

<section id="task-progress-panel" class="card d-none" aria-live="polite">
  <div class="card-header d-flex justify-content-between"><strong>任务进度</strong><span id="task-status">等待开始</span></div>
  <div class="card-body">
    <div class="d-flex justify-content-between mb-2"><span id="task-batch">尚未进入批次</span><span id="task-percentage">0%</span></div>
    <div class="progress mb-3" role="progressbar"><div id="task-progress" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div></div>
    <div id="task-summary" class="mb-2"></div>
    <div id="task-current" class="small text-secondary"></div>
    <div id="task-error" class="alert alert-danger mt-3 d-none"></div>
  </div>
</section>
<%- include("../partials/footer", { pageScript: "/assets/js/tasks.js" }) %>
