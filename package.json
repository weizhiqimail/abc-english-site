{
  "name": "abc-english-site",
  "version": "1.0.0",
  "private": false,
  "description": "ABC English vocabulary learning website",
  "scripts": {
    "env:development": "npx --yes vercel@62.4.0 --cwd . env run --project abc-english-site -e development --",
    "db:generate": "prisma generate --schema prisma/postgres/schema.prisma",
    "web:dev": "vite --config web/vite.config.js",
    "web:build": "vite build --config web/vite.config.js",
    "server": "npm run db:generate && npm run env:development -- node server/src/index.js",
    "server:dev": "npm run db:generate && npm run env:development -- nodemon --watch server/src --ext js,json server/src/index.js",
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"npm:server:dev\" \"npm:web:dev\"",
    "test": "npm run test:unit",
    "test:unit": "node --test --test-isolation=none server/src/tests/*.test.js",
    "test:smoke": "node server/src/scripts/smokeTest.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vercel:build": "npm run db:generate && npm run web:build",
    "deploy:vercel": "vercel --prod"
  },
  "dependencies": {
    "@alifd/next": "^1.27.31",
    "@prisma/client": "^6.17.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-sql": "^0.19.2",
    "prisma": "^6.17.1",
    "vite": "^7.1.10"
  }
}
